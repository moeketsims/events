# ---- Supabase (dev project) ----
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_...
SUPABASE_SECRET_KEY=                 # sb_secret_... server only, never exposed
SUPABASE_DB_URL=                     # CI only, for supabase db push

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000   # canonical origin used in QR URLs and emails
NEXT_PUBLIC_REALTIME_MODE=broadcast  # broadcast | poll — poll is the fallback if realtime.send is unavailable
PASS_SIGNING_SECRET=                 # 32+ random bytes base64; rotating invalidates all passes
CRON_SECRET=                         # bearer token for /api/cron/*

# ---- Email ----
EMAIL_PROVIDER=resend                # resend | brevo
EMAIL_FROM="CUT Events <events@example.com>"   # must be on a verified domain (Resend) or verified sender (Brevo)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BREVO_API_KEY=

# ---- WhatsApp (Meta Cloud API, direct) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=               # temporary 24h token in POC; system-user token in production
WHATSAPP_VERIFY_TOKEN=               # any string; used in the webhook GET handshake
WHATSAPP_APP_SECRET=                 # validates X-Hub-Signature-256

# ---- Payments (Yoco sandbox) ----
YOCO_SECRET_KEY=                     # sk_test_...
YOCO_WEBHOOK_SECRET=

# ---- Demo data (seed only) ----
# Resend's free tier without a verified domain delivers only to the address that
# owns the account, so the demo guests are + aliases of one real inbox:
# DEMO_EMAIL_BASE=you@gmail.com gives the first five seeded guests
# you+naledi@gmail.com and so on. Distinct addresses to the database, one inbox
# to put on the projector. Everyone else stays @example.com.
DEMO_EMAIL_BASE=
# The phone numbers registered as WhatsApp test recipients in the Meta
# dashboard, comma separated, in E.164. The same guests get them, opted in.
DEMO_PHONES=

# ---- Monitoring (optional) ----
SENTRY_DSN=
